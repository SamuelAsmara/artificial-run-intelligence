# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only. never NEXT_PUBLIC_, never in the browser
SUPABASE_SERVICE_ROLE_KEY=

# the app's own address, for auth emails and OAuth callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# a long random string; Vercel Cron sends it as a bearer token
CRON_SECRET=

# recovery data webhook (sleep / HRV / resting HR). off unless you need it
HEALTH_WEBHOOK_ENABLED=false
HEALTH_WEBHOOK_SECRET=

# optional — Strava OAuth app, https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# local scripts only (npm run analyze / check:wellness). the app itself
# stores each athlete's own credentials server-side
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=

# one time zone for the whole product
TZ=Asia/Jerusalem
