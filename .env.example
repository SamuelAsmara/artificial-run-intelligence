# Artificial Run Intelligence — משתני סביבה
# העתק לקובץ .env.local (לא נכנס ל-Git — ראו .gitignore) ומלא ערכים אמיתיים.
# הוראות מפורטות לכל שירות: README.md

# --- Supabase ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service-role: שרת בלבד! לעולם לא נחשף ללקוח (מסמך אבטחה §4/§7)
SUPABASE_SERVICE_ROLE_KEY=

# --- כתובת האפליקציה (לבניית Strava redirect URI וקישורים ב-API routes) ---
# מקומי: http://localhost:3000  |  פרודקשן: כתובת ה-Vercel שלך
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Strava API (strava.com/settings/api) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Health Webhook (מסמך אבטחה §6) ---
# מחרוזת סוד עצמאית שאתה מגדיר — למשל: openssl rand -hex 32
HEALTH_WEBHOOK_SECRET=

# --- Vercel Cron (מסמך אבטחה §6) ---
# מחרוזת סוד עצמאית להגנת /api/cron/sync-strava — למשל: openssl rand -hex 32
CRON_SECRET=
