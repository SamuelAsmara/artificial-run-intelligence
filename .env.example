# Artificial Run Intelligence — משתני סביבה
# העתק לקובץ .env.local (לא נכנס ל-Git — ראו .gitignore) ומלא ערכים אמיתיים.
# הוראות מפורטות לכל שירות: README.md
#
# הערה חשובה למי שרק רוצה להריץ ולראות:
# `npm ci && npm run build` עוברים גם בלי אף אחד מהמשתנים האלה.
# הם נדרשים כדי *להשתמש* באפליקציה — להתחבר, לסנכרן ולראות נתונים.

# ─── חובה ─────────────────────────────────────────────────────────────
# בלי אלה אין התחברות ואין נתונים.

# --- Supabase ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service-role: שרת בלבד! לעולם לא נחשף ללקוח (מסמך אבטחה §4/§7)
SUPABASE_SERVICE_ROLE_KEY=

# --- כתובת האפליקציה (לבניית Strava redirect URI וקישורים ב-API routes) ---
# מקומי: http://localhost:3000  |  פרודקשן: כתובת ה-Vercel שלך
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ─── אופציונלי ────────────────────────────────────────────────────────
# האפליקציה עולה ועובדת בלעדיהם; כל אחד מפעיל יכולת אחת.

# --- Strava API (strava.com/settings/api) ---
# הקוד קיים ואינו מחובר לממשק — ראו מסמך אפיון מוצר §8.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Health Webhook (מסמך אבטחה §6) ---
# הנתיב מושבת כברירת מחדל. כדי להפעיל: HEALTH_WEBHOOK_ENABLED=true
HEALTH_WEBHOOK_ENABLED=
# מחרוזת סוד עצמאית שאתה מגדיר — למשל: openssl rand -hex 32
HEALTH_WEBHOOK_SECRET=

# --- Vercel Cron (מסמך אבטחה §6) ---
# מחרוזת סוד עצמאית להגנת נתיבי ה-cron — למשל: openssl rand -hex 32
CRON_SECRET=

# --- intervals.icu ברמת השרת — לסקריפטים בלבד ---
# משתמש מחובר מזין את המפתח שלו בהגדרות, והוא נשמר במסד. שני אלה משמשים
# רק קריאות ללא סשן: `npm run analyze` ו-`npm run check:wellness`.
# משתמש מחובר לעולם אינו נופל אליהם — ראו lib/providers/credentials.ts.
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_ATHLETE_ID=

# --- זריעת חשבונות הדגמה (npm run seed:demo) ---
# הסיסמה המשותפת לכל חשבונות הדמו שהסקריפט יוצר. אתה בוחר אותה.
DEMO_PASSWORD=
